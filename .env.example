# ===================================================================
# Pasanaku Digital — Variables de Entorno (Docker / Producción Local)
# ===================================================================

# Configuración del Backend Django
DJANGO_SECRET_KEY=django-insecure-docker-pasanaku-taller-v
DJANGO_DEBUG=True

# Configuración de Base de Datos PostgreSQL
DB_NAME=pasanaku_db
DB_USER=pasanaku_user
DB_PASSWORD=pasanaku_password
DB_HOST=db
DB_PORT=5432
DB_PORT_FORWARD=5432

# Configuración de Puertos
FRONTEND_PORT=3000
